<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PROJECT"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="PROJECT.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TransactionCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#251B4E" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Margin" Value="10,5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 15" />
                <Setter Property="Stroke">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D946EF" Offset="0.1" />
                            <GradientStop Color="#00F2FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="OrbitronHeader" TargetType="Label">
                <Setter Property="FontFamily" Value="Orbitron" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="#A78BFA" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="MonoNumbers" TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="TextColor" Value="#00F2FF" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2D1B5A" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderColor" Value="#D946EF" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalOptions" Value="Fill" />

                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2D1B5A" />
                                    <Setter Property="BorderColor" Value="#D946EF" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2D1B5A" />
                                    <Setter Property="BorderColor" Value="#D946EF" />
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1A1033" />
                                    <Setter Property="BorderColor" Value="#00F2FF" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <ControlTemplate x:Key="MainPageTemplate">
                <Grid RowDefinitions="60, *, 85" BackgroundColor="#1A1033">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,10,20,0">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border Stroke="#00F2FF" StrokeThickness="2" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 10" BackgroundColor="#1A1033">
                                <Image Source="logomain.png" Aspect="AspectFit" Margin="5" />
                                <Border.Shadow>
                                    <Shadow Brush="#00F2FF" Opacity="0.8" Radius="15" Offset="0,0" />
                                </Border.Shadow>
                            </Border>
                            <Label Text="MONOLITH" FontSize="22" TextColor="White" FontFamily="Orbitron" FontAttributes="Bold" VerticalOptions="Center" Margin="5,0,0,0"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:HH:mm}'}" FontFamily="JetBrainsMono" FontSize="14" TextColor="#4D3B6D" VerticalOptions="Center" />
                    </Grid>

                    <ContentPresenter Grid.Row="1" />

                    <Border Grid.Row="2" BackgroundColor="#1A1033" StrokeThickness="0" Padding="10,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,0,0" />
                        </Border.StrokeShape>
                        <FlexLayout JustifyContent="SpaceEvenly" AlignItems="Center">
                            <Button Text="Кошелек 👜" Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}" CommandParameter="//MainPage" />
                            <Button Text="История 📜" Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}" CommandParameter="//HistoryPage" />
                            <Button Text="Анализ 📊" Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}" CommandParameter="//AnalyticsPage" />
                            <Button Text="Прогноз 📈" Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}" CommandParameter="//ForecastPage" />
                            <Button Text="Достижения 🏆" Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}" CommandParameter="//AchievementsPage" />
                        </FlexLayout>
                    </Border>
                </Grid>
            </ControlTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
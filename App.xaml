<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PROJECT"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="PROJECT.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#060310" />
                <GradientStop Offset="0.4" Color="#110828" />
                <GradientStop Offset="0.7" Color="#1E1038" />
                <GradientStop Offset="1.0" Color="#110828" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="LightGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#C8BFFF" />
                <GradientStop Offset="0.5" Color="#E8A8D8" />
                <GradientStop Offset="1.0" Color="#FFD0A0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ActiveBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#060310" />
                <GradientStop Offset="0.35" Color="#110828" />
                <GradientStop Offset="0.65" Color="#1E1038" />
                <GradientStop Offset="1.0" Color="#090518" />
            </LinearGradientBrush>

            <Style x:Key="TransactionCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#251B4E" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Margin" Value="10,5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 15" />
                <Setter Property="Stroke">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D946EF" Offset="0.1" />
                            <GradientStop Color="#00F2FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="OrbitronHeader" TargetType="Label">
                <Setter Property="FontFamily" Value="Orbitron" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="#A78BFA" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="MonoNumbers" TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="TextColor" Value="#00F2FF" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2D1B5A" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderColor" Value="#D946EF" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#3D2570" />
                                    <Setter Property="BorderColor" Value="#00F2FF" />
                                    <Setter Property="Scale" Value="1.03" />
                                    <Setter Property="CornerRadius" Value="10" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2D1B5A" />
                                    <Setter Property="BorderColor" Value="#D946EF" />
                                    <Setter Property="Scale" Value="1.0" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#4A1A8A" />
                                    <Setter Property="BorderColor" Value="#00F2FF" />
                                    <Setter Property="Scale" Value="0.93" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <ControlTemplate x:Key="MainPageTemplate">
                <Grid RowDefinitions="78, *, 85">

                    <!-- ── СЛОЙ 0: Базовый тёмный фон ── -->
                    <BoxView Grid.RowSpan="3"
                             Background="{DynamicResource ActiveBackground}" />

                    <!-- ── СЛОЙ 1: Глубокое свечение из центра (основной объём) ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.50">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.75">
                                <GradientStop Offset="0.0" Color="#2E1260" />
                                <GradientStop Offset="0.5" Color="#1A0D40" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 2: Верхний левый источник света (холодно-фиолетовый) ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.38">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.1,0.15" Radius="0.55">
                                <GradientStop Offset="0.0" Color="#4A1FA8" />
                                <GradientStop Offset="0.6" Color="#220E50" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 3: Нижний правый источник света (тёплый пурпур) ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.35">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.9,0.85" Radius="0.5">
                                <GradientStop Offset="0.0" Color="#5E0F88" />
                                <GradientStop Offset="0.55" Color="#2A0848" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 4: Верхний правый акцент (киановое «эхо») ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.13">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.88,0.08" Radius="0.35">
                                <GradientStop Offset="0.0" Color="#00F2FF" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 5: Нижний левый акцент (розово-магентовый отблеск) ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.15">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.05,0.92" Radius="0.35">
                                <GradientStop Offset="0.0" Color="#D946EF" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 6: Центральный «туман» — добавляет ощущение глубины ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.10">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.3">
                                <GradientStop Offset="0.0" Color="#6B21C8" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── СЛОЙ 7: Тонкий бликовый ореол сверху ── -->
                    <BoxView Grid.RowSpan="3"
                             InputTransparent="True"
                             Opacity="0.18">
                        <BoxView.Background>
                            <RadialGradientBrush Center="0.5,0">
                                <GradientStop Offset="0.0" Color="#7C5AC8" />
                                <GradientStop Offset="1.0" Color="Transparent" />
                            </RadialGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- ── Header ── -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,0">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Border Stroke="#00F2FF" StrokeThickness="2" HeightRequest="58" WidthRequest="58"
                StrokeShape="RoundRectangle 14" BackgroundColor="#1A1033"
                VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLogoTapped"/>
                                    </Border.GestureRecognizers>
                                    <Image Source="logomain.png" Aspect="Fill" Margin="0" />
                                    <Border.Shadow>
                                        <Shadow Brush="#00F2FF" Opacity="0.8" Radius="15" Offset="0,0" />
                                    </Border.Shadow>
                                </Border>
                                <Label Text="💀 ДОЛГИ" FontFamily="JetBrainsMono" FontSize="10"
       TextColor="#D946EF" HorizontalOptions="Center"
       FontAttributes="Bold" CharacterSpacing="1"/>
                            </VerticalStackLayout>
                            <Label Text="MONOLITH" FontSize="22" TextColor="White"
           FontFamily="Orbitron" FontAttributes="Bold"
           VerticalOptions="Center" Margin="5,0,0,0"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.CurrentTime}"
           FontFamily="JetBrainsMono" FontSize="14" TextColor="#4D3B6D"
           HorizontalOptions="End"/>
                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.StreakText}"
           FontFamily="JetBrainsMono" FontSize="11" TextColor="#D946EF"
           HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>

                    <ContentPresenter Grid.Row="1" />

                    <!-- ── Nav bar ── -->
                    <Border Grid.Row="2" BackgroundColor="#1A1033" StrokeThickness="0" Padding="10,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,0,0" />
                        </Border.StrokeShape>
                        <FlexLayout JustifyContent="SpaceEvenly" AlignItems="Center">
                            <Button Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="2"
        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}"
        CommandParameter="//MainPage">
                                <Button.Text>
                                    <OnPlatform x:TypeArguments="x:String">
                                        <On Platform="Android" Value="👜" />
                                        <On Platform="WinUI,iOS" Value="Кошелек 👜" />
                                    </OnPlatform>
                                </Button.Text>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="2"
        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}"
        CommandParameter="//HistoryPage">
                                <Button.Text>
                                    <OnPlatform x:TypeArguments="x:String">
                                        <On Platform="Android" Value="📜" />
                                        <On Platform="WinUI,iOS" Value="История 📜" />
                                    </OnPlatform>
                                </Button.Text>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="2"
        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}"
        CommandParameter="//AnalyticsPage">
                                <Button.Text>
                                    <OnPlatform x:TypeArguments="x:String">
                                        <On Platform="Android" Value="📊" />
                                        <On Platform="WinUI,iOS" Value="Анализ 📊" />
                                    </OnPlatform>
                                </Button.Text>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="2"
        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}"
        CommandParameter="//ForecastPage">
                                <Button.Text>
                                    <OnPlatform x:TypeArguments="x:String">
                                        <On Platform="Android" Value="📈"/>
                                        <On Platform="WinUI,iOS" Value="Прогноз 📈" />
                                    </OnPlatform>
                                </Button.Text>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}" FlexLayout.Grow="1" Margin="2"
        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.GoToCommand}"
        CommandParameter="//AchievementsPage">
                                <Button.Text>
                                    <OnPlatform x:TypeArguments="x:String">
                                        <On Platform="Android" Value="🏆" />
                                        <On Platform="WinUI,iOS" Value="Достижения 🏆" />
                                    </OnPlatform>
                                </Button.Text>
                            </Button>
                        </FlexLayout>
                    </Border>

                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
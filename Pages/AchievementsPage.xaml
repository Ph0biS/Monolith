<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
		ControlTemplate="{StaticResource MainPageTemplate}"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PROJECT.Converters"
             x:Class="PROJECT.Pages.AchievementsPage"
             BackgroundColor="#0B011D">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:StatusToColorConverter x:Key="StatusToColorConverter" />
			<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto, *">
		<VerticalStackLayout Grid.Row="0" Padding="20,15" Spacing="5">
			<Label Text="ВАШ ТИТУЛ: МАСТЕР МОНЕТ"
                   FontFamily="MontserratBold"
                   TextColor="#A78BFA"
                   HorizontalOptions="Center"
                   FontSize="18" FontAttributes="Bold"
                   CharacterSpacing="1"/>
			<Label x:Name="TotalStatsLabel"
                   Text="Разблокировано: 0 / 20" FontAttributes="Bold"
                   FontFamily="RobotoMono"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   FontSize="12"/>
			<BoxView HeightRequest="1" Color="#3D2B5E" Margin="0,10,0,0"/>
		</VerticalStackLayout>

		<CollectionView Grid.Row="1"
                        x:Name="AchievementsCollectionView"
                        Margin="15,0,15,15">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
			</CollectionView.ItemsLayout>

			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Border Stroke="#3D2B5E"
                            StrokeThickness="1"
                            BackgroundColor="#1A1033"
                            StrokeShape="RoundRectangle 15">
						<Grid ColumnDefinitions="70, *" Padding="15">

							<Grid VerticalOptions="Center" HorizontalOptions="Center">

								<Label Text="🔒"
                                       FontSize="35"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsUnlocked, Converter={StaticResource InvertedBoolConverter}}"/>

								<Label Text="{Binding Icon}"
                                       FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsUnlocked}"/>
							</Grid>

							<VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                <Label Text="{Binding Title}" FontAttributes="Bold"
                                       FontFamily="MontserratBold"
                                       FontSize="15"
                                       TextColor="{Binding IsUnlocked, Converter={StaticResource StatusToColorConverter}}" />

                                <Label Text="{Binding Description}" FontAttributes="Bold"
                                       FontFamily="Inter"
                                       TextColor="Gray"
                                       FontSize="13" />

								<VerticalStackLayout Spacing="2" Margin="0,8,0,0"
                                                     IsVisible="{Binding IsUnlocked, Converter={StaticResource InvertedBoolConverter}}">
									<ProgressBar Progress="{Binding Progress}"
                                                 ProgressColor="#8B5CF6"
                                                 HeightRequest="6" />
									<Label Text="{Binding ProgressText}"
                                           FontFamily="JetBrainsMono" FontAttributes="Bold"
                                           FontSize="10"
                                           TextColor="Gray"
                                           HorizontalOptions="End"/>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>
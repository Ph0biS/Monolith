<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             ControlTemplate="{StaticResource MainPageTemplate}"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:charts="clr-namespace:Microcharts;assembly=Microcharts"
             x:Class="PROJECT.Pages.StatisticsPage"
             BackgroundColor="#0B011D">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16">

            <Label Text="РАСПРЕДЕЛЕНИЕ" FontAttributes="Bold"
                   FontFamily="Orbitron" 
                   HorizontalOptions="Center" 
                   FontSize="22" 
                   TextColor="#A78BFA" 
                   CharacterSpacing="2"
                   Margin="0,10,0,0"/>

            <!-- Диаграмма -->
            <Border Stroke="#3D2B5E" StrokeThickness="1.5"
                    BackgroundColor="#1A1033" Padding="15" 
                    StrokeShape="RoundRectangle 24">
                <Grid HeightRequest="300">
                    <micro:ChartView x:Name="StatisticsDonutChart" 
                                     HeightRequest="270" 
                                     BackgroundColor="Transparent">
                        <micro:ChartView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChartTappedBack" />
                        </micro:ChartView.GestureRecognizers>
                    </micro:ChartView>
                </Grid>
            </Border>

            <Label Text="ДЕТАЛИЗАЦИЯ" 
                   FontFamily="Orbitron" FontAttributes="Bold"
                   FontSize="14" 
                   TextColor="#A78BFA" 
                   Margin="4,5,0,0" 
                   CharacterSpacing="1"/>

            <!-- Список категорий -->
            <CollectionView x:Name="StatisticsLegend">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="7" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#3D2B5E" StrokeThickness="1.5" 
                    Background="#1A1033" Margin="0" 
                    Padding="20,18" StrokeShape="RoundRectangle 18">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                <BoxView WidthRequest="16" HeightRequest="16" 
                             CornerRadius="8" 
                             Color="{Binding Color}" 
                             VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                           Text="{Binding Label}" 
                           FontFamily="Inter" 
                           FontAttributes="Bold"
                           TextColor="White" 
                           Margin="14,0" 
                           VerticalOptions="Center" 
                           FontSize="17"/>
                                <Label Grid.Column="2" 
                           Text="{Binding ValueLabel}" 
                           FontFamily="JetBrainsMono" 
                           FontAttributes="Bold"
                           TextColor="#2DD4BF" 
                           FontSize="17"
                           VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Лидер трат -->
            <Border Stroke="#8B5CF6" StrokeThickness="1.5"
                    Background="#2A1A4A" Padding="18" 
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="TopCategoryLabel" 
                           Text="🏆 Лидер: ---" 
                           FontFamily="Inter"
                           FontAttributes="Bold" 
                           TextColor="White" 
                           FontSize="16"/>
                    <Label x:Name="TotalTransactionsLabel" 
                           Text="Операций: 0" 
                           FontAttributes="Bold"
                           FontFamily="JetBrainsMono"
                           TextColor="#A78BFA" 
                           FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <!-- Кнопка поделиться -->
            <Button x:Name="ShareButton" 
                    Text="ПОДЕЛИТЬСЯ ОТЧЕТОМ" 
                    FontAttributes="Bold"
                    FontFamily="Orbitron" 
                    Clicked="OnShareReportClicked" 
                    BackgroundColor="#8B5CF6" 
                    TextColor="White" 
                    CornerRadius="14" 
                    HeightRequest="54"
                    Margin="0,5,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
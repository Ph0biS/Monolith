<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             ControlTemplate="{StaticResource MainPageTemplate}"
             xmlns:local="clr-namespace:PROJECT.Pages"          
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="PROJECT.Pages.MainPage"
             x:DataType="local:MainPage"
             xmlns:models="clr-namespace:PROJECT.Models"
             BackgroundColor="{DynamicResource ActiveBackground}">
    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="25" VerticalOptions="Start">

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Label x:Name="mode" Text="DARK MODE" FontAttributes="Bold" FontFamily="Inter" FontSize="10" TextColor="#A78BFA" VerticalOptions="Center" CharacterSpacing="1"/>
                    <Switch x:Name="Switch_mode" Toggled="Switch_Toggled" IsToggled="True" ThumbColor="#D946EF" />
                </HorizontalStackLayout>

                <Border x:Name="BalanceBorder" BackgroundColor="#1A1033" Stroke="#3D2B5E" Padding="20" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="МОЙ БАЛАНС" FontFamily="Inter" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" TextColor="#A78BFA" CharacterSpacing="2" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="BalanceLabel" 
                                   FontFamily="Orbitron" 
                                   Text="0 ₽" 
                                   FontSize="38" 
                                   TextColor="#2DD4BF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="10,5">
                                <Label.Shadow>
                                    <Shadow Brush="#2DD4BF" Offset="0,0" Radius="15" Opacity="0.4" />
                                </Label.Shadow>
                            </Label>

                            <Border Stroke="Transparent" StrokeThickness="0" BackgroundColor="#2A1A4A" StrokeShape="RoundRectangle 8" Padding="10,0" HeightRequest="40" VerticalOptions="Center">
                                <Picker x:Name="CurrencyPicker" Margin="-12" SelectedIndex="0" FontFamily="RobotoMono" FontAttributes="Bold" TitleColor="#A78BFA" TextColor="White" SelectedIndexChanged="OnCurrencyChanged" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>RUB</x:String>
                                            <x:String>USD</x:String>
                                            <x:String>EUR</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                            <Button Text="📥 CSV" FontFamily="Inter" FontAttributes="Bold" Clicked="OnShareReportClicked" BackgroundColor="#2A1A4A" TextColor="White" CornerRadius="10" HeightRequest="38" WidthRequest="90"/>
                            <Button Text="🔄" Clicked="OnResetStatsClicked" BackgroundColor="Transparent" TextColor="#D946EF" FontSize="18" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>


                <VerticalStackLayout x:Name="ChartContainer" Spacing="15">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Период:" FontFamily="Inter" FontAttributes="Bold" VerticalOptions="Center" TextColor="#A78BFA" />
                        <Border Stroke="#3D2B5E" BackgroundColor="#1A1033" StrokeShape="RoundRectangle 8" Padding="10,0" HeightRequest="40">
                            <Picker x:Name="PeriodPicker" Margin="-12" FontAttributes="Bold" SelectedIndex="0" SelectedIndexChanged="OnPeriodChanged" WidthRequest="150" TextColor="White" FontFamily="Inter" TitleColor="#5A4A7A" VerticalOptions="Center">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Все время</x:String>
                                        <x:String>Январь</x:String>
                                        <x:String>Февраль</x:String>
                                        <x:String>Март</x:String>
                                        <x:String>Апрель</x:String>
                                        <x:String>Май</x:String>
                                        <x:String>Июнь</x:String>
                                        <x:String>Июль</x:String>
                                        <x:String>Август</x:String>
                                        <x:String>Сентябрь</x:String>
                                        <x:String>Октябрь</x:String>
                                        <x:String>Ноябрь</x:String>
                                        <x:String>Декабрь</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>

                    <Grid>
                        <VerticalStackLayout x:Name="ChartVisualElements" 
                         IsVisible="False" 
                         Spacing="10">

                            <VerticalStackLayout x:Name="MainDashboardView">
                                <Grid HeightRequest="300" WidthRequest="300" HorizontalOptions="Center">
                                    <micro:ChartView x:Name="ChartV" HeightRequest="300" WidthRequest="300" BackgroundColor="Transparent">
                                        <micro:ChartView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnChartTapped" />
                                        </micro:ChartView.GestureRecognizers>
                                    </micro:ChartView>
                                </Grid>
                            </VerticalStackLayout>
                            <Border x:Name="AtlasLoadingView" BackgroundColor="#140B2D" Stroke="#00F2FF" Padding="15" StrokeShape="RoundRectangle 15" Margin="0,5">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Text="🤖" FontSize="26" VerticalOptions="Center" Margin="0,0,12,0"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="ATLAS AI • АНАЛИЗАТОР" FontFamily="Orbitron" FontAttributes="Bold" FontSize="11" TextColor="#00F2FF" CharacterSpacing="1"/>
                                        <Label Text="Система активна. Выберите рабочий период, чтобы я построил интерактивную диаграмму и рассчитал метрики расходов." FontFamily="Inter" FontSize="13" TextColor="White" LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border x:Name="AtlasPeriodPlaceholder" 
                BackgroundColor="#140B2D" Stroke="#D946EF" StrokeThickness="1.5" 
                StrokeShape="RoundRectangle 16" Padding="18" Margin="0,15,0,5" 
                MaximumWidthRequest="320" HorizontalOptions="Center">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="🤖" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="ATLAS_ANALYTICS_OS" TextColor="#2DD4BF" FontFamily="Orbitron" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                            <BoxView WidthRequest="6" HeightRequest="6" Color="#2DD4BF" CornerRadius="3" VerticalOptions="Center">
                                                <BoxView.Shadow>
                                                    <Shadow Brush="#2DD4BF" Offset="0,0" Radius="8" Opacity="0.8"/>
                                                </BoxView.Shadow>
                                            </BoxView>
                                            <Label Text="ONLINE" TextColor="#2DD4BF" FontFamily="JetBrainsMono" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#3D2B5E" HorizontalOptions="Fill"/>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="&gt; СКАНИРОВАНИЕ ПЕРИОДА..." TextColor="#5A4A7A" FontFamily="JetBrainsMono" FontSize="10" FontAttributes="Bold"/>
                                        <Label x:Name="AtlasPeriodSuggestionLabel" Text="Инициализация аналитического модуля..." TextColor="#A78BFA" FontFamily="Inter" FontSize="13" FontAttributes="Bold" LineBreakMode="WordWrap" LineHeight="1.3"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border x:Name="ChartInstructionBorder" 
                Margin="20,10,20,20" Padding="15,10" BackgroundColor="#1E293B" 
                Stroke="#475569" StrokeThickness="1" StrokeShape="RoundRectangle 12" 
                HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label Text="ⓘ" TextColor="#38BDF8" FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="Нажмите на диаграмму для анализа" TextColor="#94A3B8" FontSize="13"/>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="EmptyStatePlaceholder" 
                         IsVisible="True"
                         VerticalOptions="Center" HorizontalOptions="Center" 
                         Spacing="15" Margin="0,20">
                            <Border x:Name="AtlasGreetingCard" 
                BackgroundColor="#140B2D" Stroke="#3D2B5E" StrokeThickness="1.5" 
                StrokeShape="RoundRectangle 16" Padding="20" MaximumWidthRequest="320">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="🤖" FontSize="18" VerticalOptions="Center"/>
                                        <Label Text="ATLAS AI" TextColor="#2DD4BF" FontAttributes="Bold" FontSize="14" CharacterSpacing="1.5" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <BoxView HeightRequest="1" Color="#3D2B5E" HorizontalOptions="Fill"/>
                                    <Label Text="Привет! Я проверил этот период, но транзакций пока нет.&#10;&#10;Добавьте первую запись о расходах или доходах ниже, и я сразу составлю для вас интерактивный неоновый график!" 
                       TextColor="#A78BFA" FontSize="13" FontAttributes="Bold" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" LineHeight="1.3"/>
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="Ожидание первых данных..." TextColor="#5A4A7A" FontSize="11" FontFamily="Inter" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Border Stroke="#3D2B5E" Background="#140B2D" Padding="20" StrokeShape="RoundRectangle 15" Margin="0,10,0,5">
                    <VerticalStackLayout Spacing="12">
                        <Border Stroke="#3D2B5E" StrokeThickness="0" BackgroundColor="#0B011D" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry x:Name="DescriptionEntry" Margin="-9.5" Placeholder="Описание" FontAttributes="Bold" FontFamily="Inter" PlaceholderColor="#5A4A7A" TextColor="White"/>
                        </Border>

                        <Border Stroke="#3D2B5E" StrokeThickness="0" BackgroundColor="#0B011D" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry x:Name="AmountEntry" Placeholder="Сумма" Margin="-9.5" FontAttributes="Bold" FontFamily="JetBrainsMono" Keyboard="Numeric" PlaceholderColor="#5A4A7A" TextColor="#2DD4BF"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="1">

                            <Border x:Name="BtnExpenseBorder" Stroke="#D946EF" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="45">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2A1A4A" Offset="0.0" />
                                        <GradientStop Color="#140B2D" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExpenseClicked" />
                                    <PointerGestureRecognizer 
            PointerEntered="OnExpenseHoverEnter"
            PointerExited="OnExpenseHoverExit" />
                                </Border.GestureRecognizers>
                                <Label x:Name="LblExpense" Text="💸 РАСХОД"  FontFamily="Orbitron" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#7A2D6A" FontSize="13"/>
                            </Border>

                            <Border x:Name="BtnIncomeBorder" Grid.Column="1" Stroke="#2DD4BF" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="45">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#162D2A" Offset="0.0" />
                                        <GradientStop Color="#140B2D" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIncomeClicked" />
                                    <PointerGestureRecognizer 
            PointerEntered="OnIncomeHoverEnter"
            PointerExited="OnIncomeHoverExit" />
                                </Border.GestureRecognizers>
                                <Label x:Name="LblIncome" Text="💰 ДОХОД" FontAttributes="Bold" FontFamily="Orbitron" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#1E6B60" FontSize="13"/>
                            </Border>
                        </Grid>

                        <Border Stroke="#3D2B5E" StrokeThickness="0" BackgroundColor="#1A1033" Padding="10,0" StrokeShape="RoundRectangle 11" HeightRequest="45">
                            <Picker x:Name="CategoryPicker" Margin="-9.5" FontAttributes="Bold" FontFamily="Inter" TextColor="White" TitleColor="#A78BFA" HorizontalOptions="Fill" VerticalOptions="Center"/>
                        </Border>

                        <Button x:Name="AddTransactionBtn" Text="ДОБАВИТЬ ЗАПИСЬ" Style="{StaticResource SynthwaveButton}" FontAttributes="Bold" FontFamily="Orbitron" Clicked="OnAddTransactionClicked" TextColor="White" HeightRequest="50" CharacterSpacing="1" Margin="0,5,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8B5CF6" Offset="0.1" />
                                    <GradientStop Color="#D946EF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Shadow>
                                <Shadow Brush="#D946EF" Offset="0,0" Radius="15" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="25">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="ЦЕЛИ И КОПИЛКИ" FontFamily="Orbitron" FontAttributes="Bold" FontSize="16" TextColor="#A78BFA" Margin="0,10,0,0" CharacterSpacing="1"/>
                        <Border Stroke="#3D2B5E" Padding="10" StrokeShape="RoundRectangle 12" BackgroundColor="#1A1033">
                            <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                                <Entry x:Name="GoalNameEntry" Placeholder="Название" FontAttributes="Bold" FontFamily="Inter" TextColor="White" PlaceholderColor="#5A4A7A"/>
                                <Entry Grid.Column="1" x:Name="GoalTargetEntry" Placeholder="Сумма" FontAttributes="Bold" FontFamily="JetBrainsMono" Keyboard="Numeric" TextColor="#2DD4BF" PlaceholderColor="#5A4A7A"/>
                                <Button Grid.Column="2" Text="💲" Clicked="OnAddGoalClicked" 
        BackgroundColor="#8B5CF6" WidthRequest="45" HeightRequest="45"
        CornerRadius="10" Padding="0" FontSize="18"/>
                            </Grid>
                        </Border>

                        <Border x:Name="AtlasGoalsAnalyticsBox" BackgroundColor="#0F172A" Stroke="#2DD4BF" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16,18,16" Margin="0,5,0,0" MinimumHeightRequest="75">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="⚡" TextColor="#2DD4BF" FontSize="16" Margin="0,0,10,0" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="ATLAS_AI // СТРАТЕГИЯ ЦЕЛЕЙ" TextColor="#2DD4BF" FontFamily="Orbitron" FontSize="10" FontAttributes="Bold"/>
                                    <Label x:Name="AtlasGoalsSuggestionLabel" Text="Анализ прогресса: Твоя цель 'ПК' запущена. Чтобы собрать 120 000 ₽ быстрее, попробуй сократить спонтанные расходы в этом месяце." TextColor="#94A3B8" FontSize="12" FontAttributes="Bold" FontFamily="Inter" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout x:Name="SavingsCollection" BindableLayout.ItemsSource="{Binding UserSavings}">
                            <BindableLayout.ItemTemplate >
                                <DataTemplate x:DataType="models:SavingsGoal">
                                    <Border BackgroundColor="#1A1033" Stroke="#3D2B5E" Margin="0,5" Padding="12" StrokeShape="RoundRectangle 15">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Label Text="🎯" FontSize="20" VerticalOptions="Center"/>
                                                <VerticalStackLayout Grid.Column="1" Margin="10,0">
                                                    <Label Text="{Binding Name}" FontFamily="Montserrat" FontAttributes="Bold" TextColor="White"/>
                                                    <Label Text="{Binding ProgressText}" FontFamily="JetBrainsMono" FontAttributes="Bold" FontSize="11" TextColor="#A78BFA"/>
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                                    <Button Text="🚀" Clicked="OnDepositGoalClicked" CommandParameter="{Binding .}" BackgroundColor="#2DD4BF" TextColor="#0B011D" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"/>
                                                    <Button Text="🗑️" Clicked="OnDeleteGoalClicked" CommandParameter="{Binding .}" BackgroundColor="#D946EF" WidthRequest="32" HeightRequest="32" CornerRadius="16" FontSize="10" Padding="0"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}" ProgressColor="#8B5CF6" ScaleY="2"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="ПОДПИСКИ" FontFamily="Orbitron" FontAttributes="Bold" FontSize="16" TextColor="#A78BFA" Margin="0,5,0,0" CharacterSpacing="1"/>
                        <Border Stroke="#3D2B5E" Background="#1A1033" Padding="10" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*, 60, 80, Auto" ColumnSpacing="5">
                                <Entry x:Name="SubNameEntry" Placeholder="Имя" FontFamily="Inter" FontAttributes="Bold" TextColor="White" PlaceholderColor="#5A4A7A"/>
                                <Entry Grid.Column="1" x:Name="SubPriceEntry" Placeholder="Цена" FontAttributes="Bold" FontFamily="JetBrainsMono" Keyboard="Numeric" TextColor="#D946EF" PlaceholderColor="#5A4A7A"/>
                                <DatePicker Grid.Column="2" x:Name="SubDatePicker" FontFamily="RobotoMono" FontAttributes="Bold" Format="dd/MM" TextColor="White" FontSize="11" MinimumWidthRequest="80"/>
                                <Button Grid.Column="3" Text="➕" Clicked="OnAddSubscriptionClicked" BackgroundColor="#D946EF" WidthRequest="45" HeightRequest="45" CornerRadius="10" Padding="0" FontSize="16"/>
                            </Grid>
                        </Border>

                        <Border x:Name="AtlasSubscriptionsPlaceholder" IsVisible="False" BackgroundColor="#110724" Stroke="#D946EF" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="18,16,18,16" Margin="0,5,0,0" MinimumHeightRequest="75">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="🔮" FontSize="18" VerticalOptions="Center" Margin="0,0,10,0">
                                    <Label.Shadow>
                                        <Shadow Brush="#D946EF" Offset="0,0" Radius="10" Opacity="0.5"/>
                                    </Label.Shadow>
                                </Label>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="AtlasSubscriptionsTitleLabel" Text="SYSTEM_MONITOR: ПОДПИСКИ НЕ НАЙДЕНЫ" TextColor="#D946EF" FontFamily="Orbitron" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label x:Name="AtlasSubscriptionsSuggestionLabel" Text="Атлас готов отслеживать твои регулярные списания. Добавь первую подписку, чтобы активировать трекер." TextColor="#A78BFA" FontSize="12" FontAttributes="Bold" FontFamily="Inter" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <CollectionView x:Name="SubsCollectionView" ItemsSource="{Binding Subscriptions}"
                VerticalOptions="Fill">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Subscription">
                                    <Border BackgroundColor="#1A1033" Stroke="#3D2B5E" Margin="0,5" Padding="12" StrokeShape="RoundRectangle 12">
                                        <Grid ColumnDefinitions="40, *, Auto, 40">
                                            <Label Text="💳" FontSize="18" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" Margin="10,0"/>
                                            <Label Grid.Column="2" Text="{Binding Price}" FontAttributes="Bold" TextColor="#D946EF" FontSize="14" VerticalOptions="Center"/>
                                            <Button Grid.Column="3" Text="✕" Clicked="OnDeleteSubscriptionClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#5A4A7A" FontSize="14"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
